#!/bin/bash
set -euxo pipefail

# 1. Wait until Instruqt has finished preparing the machine.
until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
  echo "Waiting for Instruqt bootstrap to complete"
  sleep 1
done

# 2. Install Docker Engine and the sbx CLI using Docker's official script.
curl -fsSL https://get.docker.com | SBX=1 sh

# 3. Sign in to Docker with the read-only token stored as an Instruqt secret.
#    Turn off command printing (set +x) so the token never appears in the logs.
set +x
echo "$DOCKER_PAT" | sbx login --username faizsbxlab --password-stdin
set -x

# 4. Choose the network preset in advance, so learners aren't asked.
sbx policy init balanced

# 5. Create the learner's project folder, and open every terminal there,
#    so "sbx run ... ." shares only that folder.
mkdir -p /root/project
echo 'cd /root/project' >> /root/.bashrc